[Unit]
Description=RTSP Stream Viewer (Go backend)
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/rtsp-stream-viewer
EnvironmentFile=/home/ubuntu/rtsp-stream-viewer/.env
ExecStart=/home/ubuntu/rtsp-stream-viewer/bin/server
Restart=on-failure
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
