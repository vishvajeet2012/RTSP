PORT=8080
APP_ENV=development
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FFMPEG_PATH=ffmpeg
STREAM_RECONNECT_MAX_ATTEMPTS=5
RTSP_TIMEOUT_SECONDS=20
MAX_STREAMS=6
MAX_CLIENTS_PER_STREAM=20
LOG_LEVEL=info
# Production requires a random token of 24+ characters. Enter it using Access in the UI.
API_TOKEN=
# Exact comma-separated camera hostnames/IPs; required in production.
# Native local dev: localhost,127.0.0.1 | Docker local dev: mediamtx
ALLOWED_RTSP_HOSTS=
# Optional built React frontend directory; the demo image sets /app/web.
FRONTEND_DIR=
# On Render, omitted ALLOWED_ORIGINS defaults to its RENDER_EXTERNAL_URL.
